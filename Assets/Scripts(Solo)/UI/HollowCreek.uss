.mission { position: absolute; top: 32px; left: 38px; max-width: 720px; padding: 18px 24px; background-color: rgba(7, 14, 18, 0.88); border-left-width: 3px; border-left-color: rgb(113, 185, 180); }
.eyebrow { font-size: 13px; color: rgb(135, 193, 188); margin-bottom: 8px; letter-spacing: 2px; }
.objective { font-size: 22px; color: rgb(239, 241, 226); white-space: normal; }
.reticle { position: absolute; left: 50%; top: 48%; color: rgba(235, 244, 235, 0.8); font-size: 22px; }
.prompt { position: absolute; bottom: 170px; align-self: center; font-size: 21px; color: rgb(222, 249, 237); background-color: rgba(7, 14, 18, 0.93); padding: 12px 24px; border-bottom-width: 2px; border-bottom-color: rgb(113, 185, 180); }
.subtitle { position: absolute; bottom: 58px; left: 17%; right: 17%; padding: 14px 20px; background-color: rgba(4, 8, 12, 0.92); color: rgb(244, 238, 220); font-size: 22px; white-space: normal; -unity-text-align: middle-center; }
.controls { position: absolute; bottom: 16px; align-self: center; font-size: 13px; color: rgb(214, 224, 219); background-color: rgba(7, 14, 18, 0.75); padding: 5px 12px; }
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(2, 6, 10, 0.84); }
.card { width: 790px; max-height: 650px; padding: 30px 36px; background-color: rgb(15, 25, 30); border-width: 1px; border-color: rgb(84, 112, 115); }
.title { font-size: 32px; color: rgb(243, 238, 220); margin-bottom: 18px; white-space: normal; }
.body { font-size: 21px; color: rgb(222, 228, 220); white-space: normal; margin-bottom: 12px; }
.feedback { font-size: 16px; color: rgb(235, 187, 117); white-space: normal; margin-top: 8px; }
.actions { flex-direction: row; justify-content: flex-end; margin-top: 12px; flex-wrap: wrap; }
Button { background-color: rgb(34, 57, 62); color: rgb(238, 245, 232); border-width: 1px; border-color: rgb(108, 153, 149); padding: 11px 20px; margin: 4px; font-size: 18px; }
Button:hover { background-color: rgb(52, 86, 90); border-color: rgb(173, 223, 205); }
Button:focus { border-color: rgb(241, 211, 144); }
.code-input { margin: 14px 4px; font-size: 28px; min-height: 48px; }
.code-input > .unity-text-field__input { background-color: rgb(5, 14, 19); color: rgb(220, 250, 230); padding: 8px 14px; }
.qte-box { position: absolute; top: 37%; align-self: center; width: 400px; padding: 28px; background-color: rgba(20, 4, 5, 0.9); border-width: 2px; border-color: rgb(235, 156, 107); }
.qte { font-size: 34px; color: rgb(255, 231, 200); margin-bottom: 16px; -unity-text-align: middle-center; }
.unity-progress-bar__progress { background-color: rgb(224, 163, 93); }
.flash { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.puzzle-row { flex-direction: row; align-items: center; justify-content: space-around; }
.flag-reference { width: 225px; height: 225px; }
.tile-board { width: 300px; height: 300px; flex-direction: column; flex-shrink: 0; }
.tile-board-row { width: 300px; height: 100px; flex-direction: row; flex-shrink: 0; }
.tile { width: 96px; height: 96px; min-width: 96px; min-height: 96px; flex-shrink: 0; margin: 2px; padding: 4px; -unity-text-align: lower-right; color: rgb(255, 231, 115); -unity-font-style: bold; text-shadow: 1px 1px 2px rgb(0, 0, 0); }
.tile.empty { background-color: rgb(6, 12, 15); border-color: rgb(37, 55, 59); }
.segment-row { flex-direction: row; align-items: center; justify-content: center; margin: 14px 0; }
.seven-segment { width: 54px; height: 86px; background-color: rgb(4, 12, 13); }
.segment { position: absolute; background-color: rgb(17, 33, 32); }
.segment.segment-on { background-color: rgb(122, 230, 184); }
.segment-arrow { margin: 0 16px; color: rgb(154, 175, 170); font-size: 24px; }
.segment-question { color: rgb(240, 212, 154); font-size: 50px; }
