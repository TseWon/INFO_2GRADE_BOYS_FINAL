  lines:
  - startsWith: "\uBC00\uB7EC: 1953\uB144"
    clip: {fileID: 8300000, guid: b1077885435150d4fb8e62e616e64726, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uADF8 \uBB34\uB835"
    clip: {fileID: 8300000, guid: 0d8144498f9ce234cab8563b2fe3598e, type: 3}
    pitch: 0.9
  - startsWith: "\uB9AC\uB4DC: \uD558\u2026"
    clip: {fileID: 8300000, guid: aa3700d9b1c37894ebd11fdae8d18934, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uC798\uD588\uC5B4."
    clip: {fileID: 8300000, guid: 9a7dd920bcaf8d144bb50cd7b133e1b1, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uC774 \uC2B9\uAC15\uAE30\uB85C"
    clip: {fileID: 8300000, guid: 37a5f19c7cd64b24a97f00666fe85665, type: 3}
    pitch: 0.9
  - startsWith: "\uCF5C: \uC65C \uC62C\uB77C\uAC00\uB294"
    clip: {fileID: 8300000, guid: 0bff2be2651c51f41a67ef0029ab4671, type: 3}
    pitch: 0.9
  - startsWith: "\uB9AC\uB4DC: \uC704\uB97C \uBD10!"
    clip: {fileID: 8300000, guid: 582323af04c45b64d9c4d0629923cb6b, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uC7A1\uC558\uB2E4!"
    clip: {fileID: 8300000, guid: ca4571db9d6076e468409efb19ede11d, type: 3}
    pitch: 0.9
  - startsWith: "\uB9AC\uB4DC: \uB2E4\uB978 \uB458\uC744"
    clip: {fileID: 8300000, guid: 987c98e1dcce543499d6ed97c37c08bb, type: 3}
    pitch: 0.9
  - startsWith: "\uCF5C: \uAC08\uBE44\uBF08\uAC00"
    clip: {fileID: 8300000, guid: 1eec4c6ac6ffa27449155370d6b17ec2, type: 3}
    pitch: 0.9
  - startsWith: "\uCF5C: \uB4A4\uC5D0\u2026"
    clip: {fileID: 8300000, guid: 4ae9930244feb6049bb1f16d444aeec7, type: 3}
    pitch: 0.9
  - startsWith: "\uBB34\uC804\uAE30: \u2026\uC5EC\uAE30\uB294 \uCF5C"
    clip: {fileID: 8300000, guid: e778b034628128249b09ccdf4cdddbd3, type: 3}
    pitch: 0.95
  - startsWith: "\uBB34\uC804\uAE30: \uB3C4\uB9DD\uCCD0!"
    clip: {fileID: 8300000, guid: 63dae459f0ddf684e9244a7734b4cc06, type: 3}
    pitch: 0.95
  - startsWith: "\uBC00\uB7EC: \uC5EC\uAE30\uAC00 \uB9C8\uC9C0\uB9C9"
    clip: {fileID: 8300000, guid: e8bc6913e481ecd42a76e6a6c8771f64, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uC0B4\uC544 \uC788\uC5C8\uAD70!"
    clip: {fileID: 8300000, guid: 95db7794c7cd34b4c97c9ec13c191d55, type: 3}
    pitch: 0.9
  - startsWith: "\uB9AC\uB4DC: \uC800\uAC74\u2026"
    clip: {fileID: 8300000, guid: 02e81961d17299044a2f179a126d9781, type: 3}
    pitch: 0.9
  - startsWith: "\uBC00\uB7EC: \uB6F0\uC5B4!"
    clip: {fileID: 8300000, guid: d702b63d7510cc54f978b0b53d2b3975, type: 3}
    pitch: 0.9
  - startsWith: "\uB9AC\uB4DC: \uBB38\uC11C\uBD80\uD130"
