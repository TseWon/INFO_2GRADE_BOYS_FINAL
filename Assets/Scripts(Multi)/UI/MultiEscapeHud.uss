.escape-hud {
    flex-grow: 1;
    color: rgb(236, 236, 236);
    font-size: 16px;
}
.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 16px 26px;
    background-color: rgba(10, 10, 10, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: rgb(100, 100, 100);
}
.eyebrow { font-size: 12px; color: rgb(174, 174, 174); }
.role { font-size: 23px; -unity-font-style: bold; }
.timer { font-size: 38px; -unity-font-style: bold; -unity-text-align: middle-center; min-width: 115px; }
.hearts { font-size: 16px; -unity-text-align: middle-right; }
.spacer { flex-grow: 1; }
.footer { padding: 14px 26px; background-color: rgba(10, 10, 10, 0.93); }
.status { font-size: 19px; -unity-font-style: bold; }
.hint { color: rgb(190, 190, 190); margin-top: 5px; white-space: normal; }
.toolbar { flex-direction: row; margin-top: 9px; }
.control {
    color: rgb(240, 240, 240);
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgb(100, 100, 100);
    border-radius: 3px;
    padding: 7px 15px;
    margin-right: 10px;
    -unity-font-style: bold;
}
.control:hover { background-color: rgb(75, 75, 75); }
.control:active { background-color: rgb(110, 110, 110); }
.modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 180px;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}
.card {
    width: 800px;
    max-width: 90%;
    padding: 20px;
    background-color: rgb(22, 22, 22);
    border-width: 1px;
    border-color: rgb(150, 150, 150);
}
.title { font-size: 29px; -unity-font-style: bold; margin: 6px 0; white-space: normal; }
.body { font-size: 16px; white-space: normal; margin-bottom: 10px; }
.hidden { display: none; }
.connection-controls { margin-bottom: 8px; flex-direction: row; align-items: center; flex-wrap: wrap; }
.address-field { margin: 6px 0; font-size: 16px; flex-grow: 1; width: 260px; }
.address-field .unity-text-field__input { background-color: rgb(50, 50, 50); color: white; padding: 7px; }
.connection-status { font-size: 16px; margin-top: 8px; }
.notice { position: absolute; top: 195px; left: 26px; font-size: 20px; -unity-font-style: bold; }
.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
}
.aim-mark {
    position: absolute;
    background-color: white;
    border-width: 1px;
    border-color: rgb(15, 15, 15);
}
.aim-top { left: 14px; top: 0; width: 4px; height: 10px; }
.aim-bottom { left: 14px; top: 22px; width: 4px; height: 10px; }
.aim-left { left: 0; top: 14px; width: 10px; height: 4px; }
.aim-right { left: 22px; top: 14px; width: 10px; height: 4px; }
.aim-dot { left: 13px; top: 13px; width: 6px; height: 6px; border-radius: 3px; }
.voice-panel { position: absolute; top: 100px; left: 26px; right: 26px; padding: 8px; background-color: rgba(10, 10, 10, 0.93); }
.voice-controls { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 5px; }
.microphone-field { flex-grow: 1; min-width: 240px; margin-right: 10px; }
.microphone-field .unity-base-field__input { background-color: rgb(50, 50, 50); color: white; }
.microphone-field .unity-base-popup-field__text { color: white; }
.campaign-journal {
    position: absolute;
    left: 26px;
    top: 225px;
    max-width: 330px;
    padding: 15px;
    background-color: rgba(12, 17, 18, 0.88);
    border-left-width: 3px;
    border-left-color: rgb(210, 159, 64);
    color: rgb(238, 225, 194);
    white-space: normal;
    font-size: 17px;
}
.campaign-prompt {
    position: absolute;
    left: 25%;
    right: 25%;
    bottom: 170px;
    -unity-text-align: middle-center;
    color: rgb(255, 225, 156);
    font-size: 21px;
    white-space: normal;
    -unity-font-style: bold;
}
.campaign-stamina { position: absolute; right: 26px; bottom: 170px; color: rgb(192, 221, 220); font-size: 16px; }
.campaign-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
